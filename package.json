{
  "name": "store-canary",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x",
    "yarn": "1.22.22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/distinguish-not-found-title.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:export": "node --test tests/static-export.test.mjs",
    "test:asset-size": "node --test tests/asset-size-budget.test.mjs",
    "test:wrangler": "node --test tests/wrangler-integration.test.mjs",
    "test:workflows": "bash scripts/lint-workflows.sh",
    "test:ci-guard": "node --test tests/ci-no-deploy.test.mjs",
    "test:path-case": "node --test tests/path-case-collisions.test.mjs",
    "test:conflicts": "node --test tests/merge-conflict-markers.test.mjs",
    "test:secrets": "node --test tests/secret-patterns.test.mjs",
    "test:licenses": "node --test tests/license-inventory.test.mjs",
    "test:docs": "markdownlint-cli2 && node --test tests/docs-links.test.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "yarn test:ci-guard && yarn test:path-case && yarn test:conflicts && yarn test:secrets && yarn test:licenses && yarn lint && yarn test:docs && yarn typecheck && yarn test && yarn test:e2e && yarn format:check && yarn build && yarn test:export && yarn test:asset-size && yarn test:wrangler && yarn audit --level high",
    "deploy:cloudflare": "yarn build && npx wrangler@4.120.1 deploy"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "^10",
    "eslint-config-next": "16.3.0",
    "jsdom": "30.0.1",
    "markdownlint-cli2": "0.23.2",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve": "^14.2.6",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "4.1.10",
    "wrangler": "^4.123.0"
  },
  "packageManager": "yarn@1.22.22"
}
