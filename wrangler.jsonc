{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "store-canary",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  "routes": [
    { "pattern": "storecanary.app", "custom_domain": true },
    { "pattern": "www.storecanary.app", "custom_domain": true },
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
}
